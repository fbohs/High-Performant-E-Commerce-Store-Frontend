# ShopHub frontend — environment template
# Copy to .env.local and fill in real values. .env.local is gitignored.
# Vars prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# Everything else is server-only (route handlers, Server Components, instrumentation).

# ---- Public (browser + server) ----
# Backend base URL the browser hits (e.g. via fetch from a Client Component).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# Canonical frontend URL — used for absolute links, OG tags, callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Server-only ----
# Backend base URL for SSR / route handlers. Often equals the public one in dev,
# but in prod it may be an internal cluster address (e.g. http://api.svc.cluster.local).
API_BASE_URL=http://localhost:8080/api
# Backend API key for server-to-server calls. Never expose to the browser.
API_KEY=replace-me-with-a-real-server-api-key
# JWT signing secret. Must be at least 32 characters.
JWT_SECRET=replace-me-with-a-32-plus-character-random-secret
# JWT lifetime, accepted by the JWT library (e.g. "7d", "12h", "3600").
JWT_EXPIRES_IN=7d
